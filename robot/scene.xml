<!-- A small textured room for the kornia robot demo. The car is MuJoCo's example car (Apache-2.0),
     with a forward-looking camera added. Sizes are in metres; the car is about 20 cm long. -->
<mujoco model="kornia_robot_room">
  <compiler autolimits="true"/>
  <option timestep="0.002"/>

  <asset>
    <texture name="floor" type="2d" builtin="checker" width="512" height="512" rgb1=".78 .78 .74" rgb2=".55 .58 .62" mark="edge" markrgb=".35 .35 .35"/>
    <material name="floor" texture="floor" texrepeat="12 12" texuniform="true" reflectance=".1"/>
    <texture name="wall" type="2d" builtin="flat" width="512" height="512" rgb1=".86 .84 .78" mark="random" random=".15" markrgb=".45 .42 .38"/>
    <material name="wall" texture="wall" texrepeat="8 1"/>
    <texture name="poster" type="2d" builtin="checker" width="256" height="256" rgb1=".95 .55 .15" rgb2=".15 .25 .55" mark="cross" markrgb="1 1 1"/>
    <material name="poster" texture="poster" texrepeat="3 2"/>
    <texture name="crate" type="2d" builtin="gradient" width="128" height="128" rgb1=".55 .35 .15" rgb2=".35 .2 .08" mark="edge" markrgb=".2 .1 0"/>
    <material name="crate" texture="crate" texrepeat="2 2"/>
    <mesh name="chasis" scale=".01 .006 .0015"
      vertex=" 9   2   0
              -10  10  10
               9  -2   0
               10  3  -10
               10 -3  -10
              -8   10 -10
              -10 -10  10
              -8  -10 -10
              -5   0   20"/>
  </asset>

  <default>
    <joint damping=".03" actuatorfrcrange="-0.5 0.5"/>
    <default class="wheel">
      <geom type="cylinder" size=".03 .01" rgba=".2 .2 .25 1"/>
    </default>
    <default class="decor">
      <site type="box" rgba=".5 1 .5 1"/>
    </default>
    <default class="wallgeom">
      <geom type="box" material="wall"/>
    </default>
  </default>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" diffuse=".8 .8 .8" specular=".2 .2 .2" castshadow="true"/>
    <geom name="floor" type="plane" size="3 3 .05" material="floor"/>
    <geom name="wall_n" class="wallgeom" pos="0 3 .2" size="3 .02 .2"/>
    <geom name="wall_s" class="wallgeom" pos="0 -3 .2" size="3 .02 .2"/>
    <geom name="wall_e" class="wallgeom" pos="3 0 .2" size=".02 3 .2"/>
    <geom name="wall_w" class="wallgeom" pos="-3 0 .2" size=".02 3 .2"/>
    <geom name="poster" type="box" pos="0 2.96 .22" size="1 .01 .15" material="poster"/>

    <body name="crate" pos="1.2 -1.0 .06">
      <geom type="box" size=".06 .06 .06" material="crate"/>
    </body>
    <body name="pillar" pos="-1.1 1.4 .12">
      <geom type="cylinder" size=".05 .12" rgba=".2 .6 .3 1"/>
    </body>
    <body name="cone" pos=".5 1.7 .06">
      <geom type="capsule" size=".025 .04" rgba=".95 .75 .1 1"/>
    </body>
    <body name="ball" pos="1.4 .35 .04">
      <freejoint/>
      <geom name="ball" type="sphere" size=".04" rgba=".9 .12 .12 1" mass=".05"/>
    </body>
    <body name="ball2" pos="-.9 -1.6 .03">
      <freejoint/>
      <geom type="sphere" size=".03" rgba=".15 .35 .9 1" mass=".04"/>
    </body>

    <body name="car" pos="0 0 .03">
      <freejoint/>
      <geom name="chasis" type="mesh" mesh="chasis" rgba=".85 .85 .9 1"/>
      <geom name="front wheel" pos=".08 0 -.015" type="sphere" size=".015" condim="1" priority="1"/>
      <camera name="front" pos=".09 0 .045" xyaxes="0 -1 0 0 0 1" fovy="65"/>
      <body name="left wheel" pos="-.07 .06 0" zaxis="0 1 0">
        <joint name="left"/>
        <geom class="wheel"/>
        <site class="decor" size=".006 .025 .012"/>
        <site class="decor" size=".025 .006 .012"/>
      </body>
      <body name="right wheel" pos="-.07 -.06 0" zaxis="0 1 0">
        <joint name="right"/>
        <geom class="wheel"/>
        <site class="decor" size=".006 .025 .012"/>
        <site class="decor" size=".025 .006 .012"/>
      </body>
    </body>
  </worldbody>

  <tendon>
    <fixed name="forward">
      <joint joint="left" coef=".5"/>
      <joint joint="right" coef=".5"/>
    </fixed>
    <fixed name="turn">
      <joint joint="left" coef="-.5"/>
      <joint joint="right" coef=".5"/>
    </fixed>
  </tendon>

  <actuator>
    <motor name="forward" tendon="forward" ctrlrange="-1 1"/>
    <motor name="turn" tendon="turn" ctrlrange="-1 1"/>
  </actuator>
</mujoco>
